---
import { Image } from "astro:assets";
import type { Locale } from "../../i18n";
import { getDictionary, t } from "../../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);

const steps = [
  {
    img: "/img/home/pic1.webp",
    title: dict.how_1_title,
    body: dict.how_1_body,
    n: 1,
  },
  {
    img: "/img/home/pic2.webp",
    title: dict.how_2_title,
    body: dict.how_2_body,
    n: 2,
  },
  {
    img: "/img/home/pic3.webp",
    title: dict.how_3_title,
    body: dict.how_3_body,
    n: 3,
  },
];
---

<section id="how-it-works" class="section section-how-works">
  <div class="container">
    <h2 class="h3 dark:text-black">{dict.how_title}</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
      {
        steps.map((step) => (
          <article>
            <div class="mb-8">
              <Image
                width={600}
                height={450}
                src={step.img}
                alt=""
                class="aspect-ratio-1/1 rounded-lg"
                format="webp"
                quality={80}
              />
            </div>
            <div>
              <span class="bg-custom-blue-100 text-custom-blue-400 text-sm px-3 py-1 rounded-full">
                {t(locale, "how_step", { n: step.n })}
              </span>
              <h3 class="h5 mt-4 mb-3 dark:text-black">{step.title}</h3>
              <p class="mt-2 text-custom-grey-100">{step.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
