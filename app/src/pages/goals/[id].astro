---
import AppLayout from '../../layouts/AppLayout.astro';
import GoalDetailSummary from '../../components/goals/GoalDetailSummary.astro';
import GoalTimeline from '../../components/goals/GoalTimeline.astro';
import { getDictionary } from '../../i18n';
import {
	getGoalById,
	getGoalPeriods,
	countGoalsForUser,
	countUnreadNotifications,
} from '../../lib/db';
import { getWorkerEnv } from '../../lib/worker-env';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const { id } = Astro.params;
if (!id) return Astro.redirect('/goals');

const env = getWorkerEnv();
const goal = await getGoalById(env.DB, env.CACHE, id, user.id);
if (!goal) return Astro.redirect('/goals');

const [periods, goalsCount, unreadCount] = await Promise.all([
	getGoalPeriods(env.DB, env.CACHE, id),
	countGoalsForUser(env.DB, user.id),
	countUnreadNotifications(env.DB, user.id),
]);
const locale = Astro.locals.locale;
const dict = getDictionary(locale);

const depositLabels = JSON.stringify({
	defaultMsg: dict.deposit_error_default,
	deleteError: dict.goal_delete_error,
});
---

<AppLayout title={goal.title} activeNav="home" goalsCount={goalsCount} unreadCount={unreadCount}>
	<p class="text-sm font-medium text-[var(--text-muted)]">{dict.goal_details_title}</p>

	<div id="goal-summary-mount">
		<div id="goal-summary-placeholder" class="h-0" aria-hidden="true"></div>
		<div
			id="goal-summary"
			data-goal-id={goal.id}
			data-saved-cents={goal.saved_amount_cents}
			data-target-cents={goal.target_amount_cents}
			data-currency={goal.currency_code}
			data-locale={locale}
			data-progress-template={dict.goal_progress}
			data-completed-at-template={dict.history_deposited_at}
		>
			<GoalDetailSummary
				goal={goal}
				locale={locale}
				progressLabel={dict.goal_progress}
			/>
		</div>
	</div>

	<h3 class="mt-10 font-display text-lg font-semibold">{dict.history_title}</h3>
	<p class="text-xs text-[var(--text-muted)]">{dict.history_swipe_hint}</p>

	<div id="goal-timeline" data-deposit-labels={depositLabels}>
		<GoalTimeline
			goal={goal}
			periods={periods}
			locale={locale}
			depositedLabel={dict.history_deposited}
			pendingLabel={dict.history_deposit_pending}
			depositDueByTemplate={dict.history_deposit_due_by}
			depositedAtTemplate={dict.history_deposited_at}
		/>
	</div>

	<div
		class="mt-10 pb-4 text-center"
		x-data={`goalDelete(${JSON.stringify({ goalId: goal.id, deleteUrl: `/api/goals/${goal.id}`, deleteError: dict.goal_delete_error })})`}
	>
		<button
			type="button"
			class="text-sm font-medium text-red-600 underline hover:text-red-700"
			@click="showDeleteModal = true"
		>
			{dict.goal_delete_link}
		</button>

		<div
			x-show="showDeleteModal"
			x-cloak
			style="display: none"
			class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
			@click.self="showDeleteModal = false"
		>
			<div class="card w-full max-w-sm p-6 text-left" role="dialog" aria-modal="true">
				<h3 class="font-display text-xl font-bold">{dict.goal_delete_confirm_title}</h3>
				<div class="mt-6 flex gap-3">
					<button
						type="button"
						class="btn-secondary flex-1"
						:disabled="deleting"
						@click="showDeleteModal = false"
					>
						{dict.goal_delete_confirm_no}
					</button>
					<button
						type="button"
						class="btn-primary flex-1 !bg-red-600 !py-3 hover:!bg-red-700"
						:disabled="deleting"
						@click="confirmDelete()"
					>
						{dict.goal_delete_confirm_yes}
					</button>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		document.addEventListener('alpine:init', () => {
			Alpine.data('goalDelete', (config) => ({
				showDeleteModal: false,
				deleting: false,
				confirmDelete() {
					this.deleting = true;
					window.f2wGoals?.deleteGoalOptimistically(
						config.goalId,
						config.deleteUrl,
						config.deleteError,
					);
				},
			}));
		});
	</script>
</AppLayout>
