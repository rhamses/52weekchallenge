---
import { formatMoney, progressPercent, formatGoalCreatedAtLabel } from '../../lib/calculations';
import type { Goal } from '../../lib/types';

interface Props {
	goal: Goal;
	locale: string;
	progressLabel: string;
	createdAtTemplate: string;
}

const { goal, locale, progressLabel, createdAtTemplate } = Astro.props;
const percent = progressPercent(goal.saved_amount_cents, goal.target_amount_cents);
const formattedTarget = formatMoney(goal.target_amount_cents, goal.currency_code, locale);
const formattedSaved = formatMoney(goal.saved_amount_cents, goal.currency_code, locale);
const createdLabel = formatGoalCreatedAtLabel(goal.created_at, locale, createdAtTemplate);
---

<a href={`/goals/${goal.id}`} class="goal-card block" data-goal-card={goal.id}>
	<h3 class="font-display text-xl font-semibold">{goal.title}</h3>
	<p class="mt-1 text-xs font-light text-[var(--text-muted)]">{createdLabel}</p>
	<div class="mt-3 flex items-end justify-between">
		<div>
			<p class="text-sm text-[var(--text-muted)]">{formattedTarget}</p>
			<p class="font-display text-2xl font-bold text-brand-primary">{formattedSaved}</p>
		</div>
		<div class="text-right">
			<p class="text-sm font-medium text-brand-primary">{progressLabel.replace('{percent}', String(percent))}</p>
			<div class="mt-2 h-2 w-24 overflow-hidden rounded-full bg-[var(--border)]">
				<div class="h-full rounded-full bg-brand-primary transition-all" style={`width: ${percent}%`} />
			</div>
		</div>
	</div>
</a>
