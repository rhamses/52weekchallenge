---
import { formatMoney, progressPercent } from '../../lib/calculations';
import type { Goal } from '../../lib/types';

interface Props {
	goal: Goal;
	locale: string;
	progressLabel: string;
}

const { goal, locale, progressLabel } = Astro.props;
const percent = progressPercent(goal.saved_amount_cents, goal.target_amount_cents);
---

<div class="goal-card mt-2">
	<h2 class="font-display text-2xl font-bold" data-goal-title>{goal.title}</h2>
	<div class="mt-4 flex items-end justify-between">
		<div>
			<p class="text-sm text-[var(--text-muted)]" data-goal-target>
				{formatMoney(goal.target_amount_cents, goal.currency_code, locale)}
			</p>
			<p class="font-display text-3xl font-bold text-brand-primary" data-goal-saved>
				{formatMoney(goal.saved_amount_cents, goal.currency_code, locale)}
			</p>
		</div>
		<div class="text-right">
			<p class="font-semibold text-brand-primary" data-goal-progress-text>
				{progressLabel.replace('{percent}', String(percent))}
			</p>
			<div class="mt-2 h-2 w-28 overflow-hidden rounded-full bg-[var(--border)]">
				<div
					class="h-full rounded-full bg-brand-primary"
					data-goal-progress-bar
					style={`width: ${percent}%`}
				/>
			</div>
		</div>
	</div>
</div>
