---
import BaseLayout from '../layouts/BaseLayout.astro';
import LottiePlayer from '../components/ui/LottiePlayer.astro';
import { getDictionary } from '../i18n';

const locale = Astro.locals.locale;
const dict = getDictionary(locale);

if (Astro.locals.user) {
	return Astro.redirect('/goals');
}
---

<BaseLayout title={dict.app_name} bodyClass="bg-[var(--welcome-bg)]">
	<div class="relative flex min-h-dvh flex-col overflow-hidden">
		<div class="pointer-events-none absolute inset-0 opacity-30">
			<div class="absolute left-1/2 top-1/4 h-96 w-96 -translate-x-1/2 rounded-full border-[40px] border-white/20" />
			<div class="absolute left-1/2 top-1/4 h-[28rem] w-[28rem] -translate-x-1/2 rounded-full border-[30px] border-white/10" />
		</div>

		<div class="flex flex-1 flex-col items-center justify-center px-6 pt-16 text-center text-white">
			<LottiePlayer
				src="/assets/wallet.lottie"
				width={280}
				height={240}
				class="mb-8 max-w-[70vw] h-auto w-full max-h-[240px]"
			/>
			<h1 class="font-display text-3xl font-bold leading-tight">{dict.welcome_title}</h1>
			<p class="mt-4 max-w-sm text-sm font-light leading-relaxed text-white/85">{dict.welcome_subtitle}</p>
		</div>

		<div class="p-6 pb-10">
			<a href="/goals/new" class="btn-primary !bg-white !text-[var(--text-primary)] hover:!bg-white/90">
				{dict.welcome_cta}
			</a>
		</div>
	</div>
</BaseLayout>
