---
import TimelineItem from './TimelineItem.astro';
import type { Goal, GoalPeriod } from '../../lib/types';

interface Props {
	goal: Goal;
	periods: GoalPeriod[];
	locale: string;
	depositedLabel: string;
	pendingLabel: string;
	depositDueByTemplate: string;
	depositedAtTemplate: string;
}

const { goal, periods, locale, depositedLabel, pendingLabel, depositDueByTemplate, depositedAtTemplate } =
	Astro.props;
---

<div class="relative mt-6 space-y-4">
	{periods.map((period) => (
		<TimelineItem
			period={period}
			currency={goal.currency_code}
			locale={locale}
			depositedLabel={depositedLabel}
			pendingLabel={pendingLabel}
			depositDueByTemplate={depositDueByTemplate}
			depositedAtTemplate={depositedAtTemplate}
			goalId={goal.id}
		/>
	))}
</div>
