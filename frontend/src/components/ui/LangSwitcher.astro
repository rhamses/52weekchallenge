---
import { getDictionary, LOCALES } from '../../i18n';

interface Props {
	locale: string;
	redirect: string;
	variant?: 'header' | 'floating';
}

const { locale, redirect, variant = 'header' } = Astro.props;
const dict = getDictionary(locale);
const currentLocale = LOCALES.find((l) => l.code === locale) ?? LOCALES[1];

const triggerClass =
	variant === 'header'
		? 'relative inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-[var(--border)] bg-[var(--card-strong)] text-xl'
		: 'flex h-10 w-10 items-center justify-center rounded-full border border-[var(--border)] bg-white text-xl shadow-sm';

const wrapperClass = variant === 'header' ? 'relative' : 'fixed right-4 top-4 z-50';
---

<div class={wrapperClass} x-data="{ open: false }">
	<button
		type="button"
		class={triggerClass}
		aria-label={dict.select_language}
		:aria-expanded="open"
		@click="open = !open"
	>
		{currentLocale.emoji}
	</button>
	<div
		x-show="open"
		x-cloak
		class="absolute right-0 z-20 mt-2 flex flex-col gap-1 rounded-xl border border-[var(--border)] bg-white p-1.5 shadow-lg"
		@click.away="open = false"
	>
		{LOCALES.map((l) => (
			<form method="POST" action="/api/locale" class="block">
				<input type="hidden" name="locale" value={l.code} />
				<input type="hidden" name="redirect" value={redirect} />
				<button
					type="submit"
					aria-label={l.label}
					class:list={[
						'flex h-10 w-10 items-center justify-center rounded-lg text-xl hover:bg-[var(--card-strong)]',
						l.code === locale && 'bg-brand-primary/10',
					]}
				>
					{l.emoji}
				</button>
			</form>
		))}
	</div>
</div>
