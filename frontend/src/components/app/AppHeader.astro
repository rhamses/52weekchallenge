---
import TablerIcon from '../ui/TablerIcon.astro';

interface Props {
	userName: string;
	goalsCount: number;
	unreadCount: number;
	avatarUrl: string;
	greeting: string;
	goalsLabel: string;
}

const { unreadCount, avatarUrl, greeting, goalsLabel } = Astro.props;
---

<header class="grid grid-cols-[auto_1fr_auto] items-center gap-4 rounded-2xl border border-[var(--border)] bg-[var(--card)] p-4 shadow-card">
	<a href="/goals" class="block">
		<figure class="h-14 w-14 overflow-hidden rounded-full border-2 border-brand-primary p-0.5">
			<img
				src={avatarUrl}
				alt=""
				width="56"
				height="56"
				class="h-full w-full rounded-full object-cover"
				referrerpolicy="no-referrer"
				onerror="this.onerror=null;this.src='/assets/avatar.svg'"
			/>
		</figure>
	</a>
	<div>
		<p class="font-display text-lg font-semibold">{greeting}</p>
		<p class="text-sm text-[var(--text-muted)]">{goalsLabel}</p>
	</div>
	<a
		href="/notifications"
		class="relative inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-[var(--border)] bg-[var(--card-strong)]"
		aria-label="Notifications"
	>
		<TablerIcon name="bell" class="h-6 w-6" />
		{unreadCount > 0 && (
			<span class="absolute right-1 top-1 flex h-4 w-4 items-center justify-center rounded-full bg-brand-primary text-[10px] font-semibold text-white">
				{unreadCount}
			</span>
		)}
	</a>
</header>
