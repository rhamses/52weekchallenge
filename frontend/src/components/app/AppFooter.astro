---
import TablerIcon from '../ui/TablerIcon.astro';
import GlassFilter from '../ui/GlassFilter.astro';
import type { Dictionary } from '../../i18n';

interface Props {
	activeNav: 'home' | 'add' | 'notifications';
	dict: Dictionary;
}

const { activeNav, dict } = Astro.props;

const items = [
	{ key: 'home' as const, href: '/goals', icon: 'home' as const, label: dict.nav_home },
	{ key: 'add' as const, href: '/goals/new', icon: 'plus' as const, label: dict.nav_add },
];
---

<div class="nav-glass-dock">
	<nav class="nav-glass" data-active-nav={activeNav} aria-label="Main navigation">
		<GlassFilter />
		<div class="nav-glass__indicator" aria-hidden="true"></div>

		{items.map((item) => (
			<a
				href={item.href}
				class:list={['nav-glass__item', item.key === activeNav && 'is-active']}
				data-nav={item.key}
				aria-label={item.label}
				data-no-transition={item.key === 'add' ? undefined : ''}
			>
				<span class="nav-glass__icon-wrap">
					<TablerIcon name={item.icon} class="h-6 w-6" />
				</span>
			</a>
		))}

		<form method="POST" action="/api/auth/logout" class="nav-glass__item m-0" data-nav="logout">
			<button
				type="submit"
				aria-label={dict.nav_logout}
				class="flex w-full items-center justify-center border-0 bg-transparent p-0 font-inherit text-inherit"
			>
				<span class="nav-glass__icon-wrap">
					<TablerIcon name="logout" class="h-6 w-6" />
				</span>
			</button>
		</form>
	</nav>
</div>
