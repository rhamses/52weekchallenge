---
import '../styles/global.css';
import { getDictionary, LOCALES, type Dictionary } from '../i18n';
import { getWorkerEnv } from '../lib/worker-env';
import type { Locale } from '../lib/types';

interface Props {
	title?: string;
	description?: string;
	showLang?: boolean;
	bodyClass?: string;
	ogImage?: string;
}

const {
	title = '52 Week Challenge',
	description = 'Save week by week toward your financial goals',
	showLang = true,
	bodyClass = '',
	ogImage = '/og-image.png',
} = Astro.props;
const locale = Astro.locals.locale;
const dict = getDictionary(locale) as Dictionary;
const currentLocale = LOCALES.find((l) => l.code === locale) ?? LOCALES[1];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href;

let vapidPublicKey = '';
try {
	vapidPublicKey = getWorkerEnv().VAPID_PUBLIC_KEY ?? '';
} catch {
	/* local without bindings */
}

const pwaLabels = JSON.stringify({
	title: dict.pwa_install_title,
	action: dict.pwa_install_action,
	iosHint: dict.pwa_install_ios_hint,
});
const pwaUpdateLabels = JSON.stringify({
	message: dict.pwa_update_available,
	reload: dict.pwa_update_reload,
});
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#16A34A" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="52 Weeks" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" href="/icons/favicon-32x32.png" type="image/png" sizes="32x32" />
		<link rel="icon" href="/icons/favicon-16x16.png" type="image/png" sizes="16x16" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="apple-touch-startup-image" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="52 Week Challenge" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={locale.replace('-', '_')} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body
		class={bodyClass}
		data-app-error-labels={JSON.stringify({ title: dict.app_error_title, ok: dict.app_error_ok })}
		data-vapid-public-key={vapidPublicKey}
		data-pwa-labels={pwaLabels}
		data-pwa-update-labels={pwaUpdateLabels}
	>
		{showLang && (
			<div class="fixed right-4 top-4 z-50" x-data="{ open: false }">
				<button
					type="button"
					class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--border)] bg-white text-xl shadow-sm"
					aria-label={dict.select_language}
					@click="open = !open"
				>
					{currentLocale.emoji}
				</button>
				<div
					x-show="open"
					x-cloak
					class="absolute right-0 mt-2 flex flex-col gap-1 rounded-xl border border-[var(--border)] bg-white p-1.5 shadow-lg"
					@click.away="open = false"
				>
					{LOCALES.map((l) => (
						<form method="POST" action="/api/locale" class="block">
							<input type="hidden" name="locale" value={l.code} />
							<input type="hidden" name="redirect" value={Astro.url.pathname} />
							<button
								type="submit"
								aria-label={l.label}
								class:list={[
									'flex h-10 w-10 items-center justify-center rounded-lg text-xl hover:bg-[var(--card-strong)]',
									l.code === locale && 'bg-brand-primary/10',
								]}
							>
								{l.emoji}
							</button>
						</form>
					))}
				</div>
			</div>
		)}
		<slot />
		<div
			x-data="appError"
			@app-error.window="open($event.detail.message)"
		>
			<div
				x-show="visible"
				x-cloak
				style="display: none"
				class="fixed inset-0 z-[60] flex items-center justify-center bg-black/40 p-4"
				@click.self="close()"
			>
				<div class="card w-full max-w-sm p-6 text-left" role="alertdialog" aria-modal="true">
					<h3 class="font-display text-xl font-bold" x-text="title"></h3>
					<p class="mt-3 text-sm text-[var(--text-muted)]" x-text="message"></p>
					<button type="button" class="btn-primary mt-6 w-full" @click="close()" x-text="okLabel"></button>
				</div>
			</div>
		</div>
		<script>
			import '../scripts/interactive.ts';
		</script>
	</body>
</html>
